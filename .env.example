# Copy to .env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Cron protection — sent as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Twilio WhatsApp (server-side only)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# App
APP_TIMEZONE="Africa/Dar_es_Salaam"

# Optional: a direct (non-pooled) connection for Prisma's CLI. If unset, the CLI
# uses DATABASE_URL with Neon's "-pooler" host swapped for the direct one.
DIRECT_DATABASE_URL=""

# Evelyn (the owner's assistant) reads /api/evelyn/summary with this shared
# secret (32+ characters). Production only.
EVELYN_API_SECRET=""
