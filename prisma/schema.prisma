generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LOAN_OFFICER
  ACCOUNTANT
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
  BLACKLIST
}

enum LoanStatus {
  ACTIVE
  SETTLED
  OVERDUE
  DEFAULTED
  WRITTEN_OFF
}

enum InstallmentStatus {
  PENDING
  INTEREST_PAID
  SETTLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  OTHER
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(LOAN_OFFICER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customersCreated Customer[]    @relation("CustomerCreatedBy")
  flagsCreated     CustomerFlag[]
  loansIssued      Loan[]
  paymentsRecorded Payment[]
  auditLogs        AuditLog[]
}

model Customer {
  id               String        @id @default(cuid())
  type             CustomerType  @default(INDIVIDUAL)
  fullName         String
  businessName     String?
  nationalIdNumber String?
  phone            String
  altPhone         String?
  email            String?
  addressLine      String
  city             String
  region           String
  occupation       String?
  employer         String?
  businessTin      String?
  notes            String?
  isFlagged        Boolean       @default(false)
  flagReason       String?
  createdById      String
  createdBy        User          @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  flags         CustomerFlag[]
  loans         Loan[]
  notifications Notification[]

  @@index([fullName])
  @@index([phone])
}

model CustomerFlag {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason      String
  severity    FlagSeverity
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([customerId])
}

model Loan {
  id              String     @id @default(cuid())
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  principal       Decimal    @db.Decimal(14, 2)
  interestRatePct Decimal    @db.Decimal(5, 2) @default(15.00)
  cyclesAllowed   Int        @default(3)
  cycleDays       Int        @default(30)
  disbursedAt     DateTime
  dueAt           DateTime
  status          LoanStatus @default(ACTIVE)
  issuedById      String
  issuedBy        User       @relation(fields: [issuedById], references: [id])
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  installments  Installment[]
  payments      Payment[]
  notifications Notification[]

  @@index([customerId])
  @@index([status])
}

model Installment {
  id                          String            @id @default(cuid())
  loanId                      String
  loan                        Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  cycleNumber                 Int
  dueDate                     DateTime
  expectedInterest            Decimal           @db.Decimal(14, 2)
  expectedPrincipalAtThisCycle Decimal          @db.Decimal(14, 2)
  status                      InstallmentStatus @default(PENDING)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  payments Payment[]

  @@unique([loanId, cycleNumber])
  @@index([dueDate])
}

model Payment {
  id              String         @id @default(cuid())
  loanId          String
  loan            Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentId   String?
  installment     Installment?   @relation(fields: [installmentId], references: [id])
  amount          Decimal        @db.Decimal(14, 2)
  principalPortion Decimal       @db.Decimal(14, 2) @default(0)
  interestPortion  Decimal       @db.Decimal(14, 2) @default(0)
  paidAt          DateTime
  method          PaymentMethod  @default(CASH)
  reference       String?
  note            String?
  recordedById    String
  recordedBy      User           @relation(fields: [recordedById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([loanId])
  @@index([paidAt])
}

model Notification {
  id                String             @id @default(cuid())
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId            String?
  loan              Loan?              @relation(fields: [loanId], references: [id])
  channel           String             @default("WHATSAPP")
  template          String
  payloadJson       Json
  status            NotificationStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  scheduledFor      DateTime
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  @@index([status])
  @@index([scheduledFor])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  at         DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}
